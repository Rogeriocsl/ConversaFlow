{
  "name": "conversaflow",
  "version": "0.5.0",
  "description": "Plataforma desktop de automação conversacional e campanhas para WhatsApp",
  "main": "main.js",
  "author": "Você",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --test",
    "test": "node --test",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-is-dev": "^2.0.0",
    "node-machine-id": "^1.1.12",
    "puppeteer": "^24.17.0",
    "qrcode": "^1.5.3",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.conversaflow.desktop",
    "productName": "ConversaFlow",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "license.js",
      "src/**/*",
      "assets/**/*",
      "package.json",
      ".env.example",
      "!**/*.map",
      "!**/node_modules/*/{test,__tests__,examples,example,*.md}"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/puppeteer*/.local-chromium/**",
      "**/resources/chrome/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/chrome/",
        "to": "resources/chrome",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".wwebjs_auth/",
        "to": ".wwebjs_auth",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": null
  }
}
